{
  "extraKnownMarketplaces": {
    "agent-kit": {
      "source": {
        "source": "github",
        "repo": "razcue/agent-kit"
      }
    }
  },
  "enabledPlugins": {
    "agent-kit@agent-kit": true
  },
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)",
      "Bash(git revert:*)",
      "Bash(git pull:*)"
    ]
  }
}
