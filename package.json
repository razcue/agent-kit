{
  "name": "@razcue/agent-kit",
  "version": "0.14.3",
  "description": "Minimal agent-driven development kit for Claude Code: project setup CLI, Nuxt + Supabase monorepo scaffold, scoped knowledge and decisions.",
  "type": "module",
  "license": "MIT",
  "author": "razcue",
  "homepage": "https://razcue.github.io/agent-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razcue/agent-kit.git"
  },
  "bugs": {
    "url": "https://github.com/razcue/agent-kit/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "agent",
    "spec-driven-development",
    "sdd",
    "tdd",
    "living-specs",
    "ears",
    "bdd",
    "qa",
    "cli"
  ],
  "bin": {
    "agent-kit": "cli/index.mjs"
  },
  "files": [
    "cli",
    "templates",
    "plugin/scripts",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs scripts/*/*.test.mjs",
    "knowledge:index": "node plugin/scripts/knowledge.mjs index --global",
    "knowledge:check": "node plugin/scripts/knowledge.mjs check --global",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7"
  }
}
